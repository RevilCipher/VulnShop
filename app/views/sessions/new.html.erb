<div class="card" style="max-width:400px;margin:auto">
  <h2>Login</h2>
  <%= form_with url: login_path, method: :post do |f| %>
    <label>Username</label>
    <%= f.text_field :username %>
    <label>Password</label>
    <%= f.password_field :password %>
    <%= f.submit "Login", class: "btn" %>
  <% end %>
</div>
